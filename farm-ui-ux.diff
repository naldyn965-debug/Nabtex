+<!-- ══ FARM OS — UI/UX POLISH (additive overrides only: look, structure, accessibility — no logic) ══ -->
+<style id="farm-ux-polish">
+/* 1) Layout — center the content column & balance the grids */
+#pg-farm .farm-view{margin-inline:auto}
+#pg-farm .farm-stats-grid{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
+#pg-farm .fsc-body{min-width:0}
+#pg-farm .fsc-value{overflow-wrap:anywhere}
+#pg-farm .farm-quick-btns{grid-template-columns:repeat(2,minmax(0,1fr))}
+#pg-farm .fqb-arrow{opacity:.45}
+#pg-farm .farm-quick-btn:hover .fqb-arrow{opacity:1}
+#pg-farm .analytics-tabs{flex-wrap:wrap}
+#pg-farm .ar-header{flex-wrap:wrap;gap:10px}
+
+/* 2) Arabic typography — letter-spacing breaks cursive joining; tight line-height clips diacritics */
+#pg-farm .farm-label,#pg-farm .fsc-label,#pg-farm .farm-form-section-label,#pg-farm .lsh-text,
+#pg-farm .farm-view-eyebrow,#pg-farm .farm-nav-item,#pg-farm .exp-sum-label,#pg-farm .exp-table thead th,
+#pg-farm .ar-card-label,#pg-farm .farm-name-badge-label{letter-spacing:0}
+#pg-farm .farm-view-title{letter-spacing:0;line-height:1.35}
+#pg-farm .farm-label{font-size:12.5px}
+#pg-farm .fsc-label,#pg-farm .exp-sum-label,#pg-farm .ar-card-label,#pg-farm .ar-card-unit{font-size:11.5px}
+#pg-farm .farm-form-section-label{font-size:12px}
+#pg-farm .lsh-text{font-size:13px}
+
+/* 3) Touch targets (≥40–44px) */
+#pg-farm .farm-input{min-height:44px}
+#pg-farm .farm-textarea{min-height:84px}
+#pg-farm .farm-btn-primary,#pg-farm .farm-btn-secondary{min-height:44px;justify-content:center}
+#pg-farm .fc-chip,#pg-farm .exp-tab,#pg-farm .an-tab,#pg-farm .exp-arch-tab{min-height:40px}
+#pg-farm .field-del-btn{min-width:40px;min-height:40px;display:inline-flex;align-items:center;justify-content:center}
+#pg-farm .exp-del-btn{min-width:40px;min-height:36px;display:inline-flex;align-items:center;justify-content:center}
+.ds-close{width:40px;height:40px}
+
+/* 4) Focus — visible ring that keeps each control's own shape (global :focus-visible forces radius 6–8px) */
+#pg-farm .farm-input:focus,#pg-farm .farm-input:focus-visible{border-color:var(--brand);box-shadow:0 0 0 3px rgba(27,107,58,.3)}
+#pg-farm .farm-input:focus-visible{border-radius:10px}
+#pg-farm .farm-btn-primary:focus-visible,#pg-farm .farm-btn-secondary:focus-visible,#pg-farm .fc-chip:focus-visible,
+#pg-farm .an-tab:focus-visible,#pg-farm .exp-tab:focus-visible,#pg-farm .exp-arch-tab:focus-visible,
+#pg-farm .farm-home-btn:focus-visible{border-radius:100px}
+#pg-farm .farm-quick-btn:focus-visible{border-radius:13px}
+#pg-farm .farm-nav-item:focus-visible{border-radius:9px;outline-offset:-2px}
+
+/* 5) Radio cards & harvest toggle were display:none → unreachable by keyboard. Visually hidden, still focusable. */
+#pg-farm .farm-radio-item input[type="radio"],
+#pg-farm .farm-harvest-toggle input[type="checkbox"]{display:block;position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
+#pg-farm .farm-harvest-toggle{position:relative}
+#pg-farm .farm-radio-item:has(input:focus-visible),
+#pg-farm .farm-harvest-toggle:has(input:focus-visible){outline:2.5px solid var(--brand);outline-offset:2px}
+
+/* 6) Selected chip — add a non-color cue (✓) */
+#pg-farm .fc-chip-active::before{content:"✓";font-weight:800;font-size:12px;line-height:1}
+
+/* 7) Dark-mode legibility for inactive tabs */
+[data-dark] #pg-farm .farm-nav-item{color:rgba(255,255,255,.68)}
+[data-dark] #pg-farm .farm-nav-item:hover{color:rgba(255,255,255,.92)}
+[data-dark] #pg-farm .farm-name-badge-label{opacity:1}
+
+/* 8) Phones / touch */
+#pg-farm .farm-top-nav{scroll-snap-type:x proximity;overscroll-behavior-x:contain}
+#pg-farm .farm-nav-item{scroll-snap-align:center}
+@media (max-width:860px),(pointer:coarse){
+  #pg-farm .farm-top-nav{max-height:48px;padding:4px}
+  #pg-farm .farm-nav-item{height:40px;font-size:11.5px}
+  #pg-farm .farm-nav-icon{width:15px;height:15px}
+  #pg-farm .farm-home-btn{min-height:40px}
+}
+@media (max-width:860px){
+  #pg-farm input:not([type="checkbox"]):not([type="radio"]),#pg-farm select,#pg-farm textarea{font-size:16px}
+}
+@media (max-width:600px){
+  #pg-farm .farm-form-card{padding:18px 14px;border-radius:16px}
+  #pg-farm .farm-form-card-header{margin-bottom:16px}
+}
+@media (max-width:480px){
+  #pg-farm .farm-quick-btns{grid-template-columns:1fr}
+}
+@media (max-width:640px){
+  #pg-farm .exp-table{min-width:560px}
+}
+
+/* 9) Reduced motion — keep the loading spinner alive, calm everything else */
+@media (prefers-reduced-motion:reduce){
+  #pg-farm *,#pg-farm *::before,#pg-farm *::after{animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.001ms !important;scroll-behavior:auto !important}
+  #pg-farm .farm-spinner{animation-duration:1.4s !important;animation-iteration-count:infinite !important}
+}
+</style>
