+ ['قنا',26.1551,32.7160,'قنا|نجع حمادي|دشنا|قوص|أبوتشت|فرشوط|نقادة'],
+ ['الأقصر',25.6872,32.6396,'الأقصر|أرمنت|إسنا|الطود|البياضية'],
