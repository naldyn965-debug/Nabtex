+  if(w6 >= TH.sprayWind || g6 >= TH.sprayGust) bad.push('الرياح ' + r0(w6) + ' كم/س (هبّات ' + r0(g6) + ') — تطيّر الرذاذ خارج الهدف');
+  else if(w6 >= TH.sprayWindW || g6 >= TH.sprayGustW) warn.push('رياح متوسطة ' + r0(w6) + ' كم/س — اقترب بالفوهة من النبات وتجنّب الرذاذ الناعم');
+  if(p6 >= 50 || rr6 >= 0.5) bad.push('احتمال مطر ' + r0(p6) + '% خلال 6 ساعات — قد يغسل المبيد');
+  else if(p6 >= 30) warn.push('احتمال مطر ' + r0(p6) + '% خلال 6 ساعات');
