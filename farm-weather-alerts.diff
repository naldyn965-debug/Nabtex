+ ['مطروح',31.3543,27.2373,'مطروح|مرسى مطروح|العلمين|الضبعة|سيوة|الحمام|سيدي براني|السلوم|النجيلة']
+];
+var GOVN = GOV.map(function(g){ return { g:g, a:g[3].split('|').map(nrm) }; });
+
+function findGov(text){
+  var n = nrm(text);
+  for(var i=0;i<GOVN.length;i++){
+    for(var j=0;j<GOVN[i].a.length;j++){ if(n.indexOf(GOVN[i].a[j]) > -1) return GOVN[i].g; }
+  }
+  return null;
+}
+function locate(text){ var g = findGov(text); return g ? { lat:g[1], lon:g[2], place:g[0] } : null; }
+
+function fetchJson(url){
+  var ctl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
+  var t = ctl ? setTimeout(function(){ try{ ctl.abort(); }catch(e){} }, TMO) : null;
+  return fetch(url, ctl ? { signal: ctl.signal } : undefined).then(function(res){
+    if(t) clearTimeout(t);
+    if(!res.ok) throw new Error('http ' + res.status);
+    return res.json();
+  }, function(e){ if(t) clearTimeout(t); throw e; });
+}
+
+/* لو الاسم مش محافظة/مركز معروف: بحث مجاني في Open-Meteo Geocoding (والنتيجة بتتحفظ محليًا) */
+function geocode(text){
+  var q = String(text||'').split(/[-–—،,\/\\]/)[0].trim();
+  if(!q) return Promise.resolve(null);
+  var key = 'nbfw:geo:' + nrm(q).trim();
+  var c = sGet(key);
+  if(c && c.lat != null) return Promise.resolve(c);
+  var url = 'https://geocoding-api.open-meteo.com/v1/search?name=' + encodeURIComponent(q) + '&count=1&language=ar&format=json&countryCode=EG';
+  return fetchJson(url).then(function(d){
+    var r = d && d.results && d.results[0];
+    if(!r) return null;
+    var out = { lat:r.latitude, lon:r.longitude, place:r.name || q };
+    sSet(key, out);
+    return out;
+  }).catch(function(){ return null; });
+}
+
+/* ───────── 2) جلب الطقس (كاش 30 دقيقة) ───────── */
+function wxUrl(lat, lon){
+  return 'https://api.open-meteo.com/v1/forecast?latitude=' + lat + '&longitude=' + lon +
+    '&current=temperature_2m,relative_humidity_2m,wind_speed_10m,wind_gusts_10m' +
+    '&hourly=temperature_2m,wind_speed_10m,wind_gusts_10m,precipitation_probability,precipitation' +
+    '&daily=temperature_2m_max,temperature_2m_min,precipitation_sum,et0_fao_evapotranspiration' +
+    '&wind_speed_unit=kmh&timezone=auto&forecast_days=3';
+}
+function validWx(d){ return !!(d && d.hourly && d.hourly.time && d.hourly.time.length > 24 && d.daily && d.daily.time && d.daily.time.length >= 2); }
+
+function getWx(c){
+  var key = 'nbfw:wx:' + c.lat.toFixed(2) + ',' + c.lon.toFixed(2);
+  var cached = sGet(key), now = Date.now();
+  if(cached && cached.data && now - cached.ts < TTL) return Promise.resolve({ data:cached.data, ts:cached.ts, stale:false });
+  if(inflight[key]) return inflight[key];
+  inflight[key] = fetchJson(wxUrl(c.lat, c.lon)).then(function(d){
+    if(!validWx(d)) throw new Error('bad data');
+    var rec = { ts:Date.now(), data:d };
+    sSet(key, rec);
+    return { data:d, ts:rec.ts, stale:false };
+  }).catch(function(){
+    if(cached && cached.data && now - cached.ts < STALE_MAX) return { data:cached.data, ts:cached.ts, stale:true };
+    return null;
+  }).then(function(x){ delete inflight[key]; return x; });
+  return inflight[key];
+}
+
+function load(farm){
+  var loc = String(farm.location || '').trim();
+  if(!loc) return Promise.resolve({ err:'noloc' });
+  var c0 = locate(loc);
+  return (c0 ? Promise.resolve(c0) : geocode(loc)).then(function(c){
+    if(!c) return { err:'geo', loc:loc };
+    return getWx(c).then(function(w){
+      if(!w) return { err:'net' };
+      return { ctx:c, data:w.data, ts:w.ts, stale:w.stale, a:assess(w.data, farm) };
+    });
+  });
+}
+
+/* ───────── 3) التقييم: صقيع / حر / رياح / رش / ري ───────── */
+function seg(arr, i, n){ return (arr || []).slice(i, i+n).filter(function(x){ return x != null; }); }
+function mx(a){ return a.length ? Math.max.apply(null, a) : null; }
+function mn(a){ return a.length ? Math.min.apply(null, a) : null; }
+function sm(a){ return a.reduce(function(s,x){ return s + x; }, 0); }
+function nowIdx(d){
+  var t = d.current && d.current.time, H = d.hourly.time, i = 0;
+  if(t){ for(var k=0;k<H.length;k++){ if(H[k] <= t) i = k; else break; } }
