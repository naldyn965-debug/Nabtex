+     ولو الاسم مش محافظة بيتم البحث عنه في Geocoding المجاني بتاع Open-Meteo.
+   • لا Firestore ولا أي كتابة في بيانات المزرعة: قراءة فقط + كاش محلي 30 دقيقة في الجهاز.
+   • لو الإنترنت واقع: بيعرض آخر بيانات محفوظة (لو أقل من 12 ساعة) أو ما يعرضش حاجة — ومفيش أي خطأ يظهر للمستخدم.
+═══════════════════════════════════════════════════════════════ */
+(function(){
+'use strict';
+
+var TTL = 30*60*1000, STALE_MAX = 12*3600*1000, TMO = 8000;
+/* عتبات التنبيه (°م / كم/س / مم) — عدّلها من هنا فقط */
+var TH = { frostD:2, frostW:4, heatW:36, heatD:38, sprayWind:20, sprayWindW:15, sprayGust:30, sprayGustW:25, rainHold:5, windAlert:25, gustAlert:40 };
+var mem = {}, inflight = {};
+
+function sGet(k){ if(mem[k]) return mem[k]; try{ var v = localStorage.getItem(k); if(v){ v = JSON.parse(v); mem[k] = v; return v; } }catch(e){} return null; }
+function sSet(k,v){ mem[k] = v; try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
+function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
